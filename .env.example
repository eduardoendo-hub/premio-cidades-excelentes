# ===== Servidor =====
PORT=3000
# Onde os PDFs enviados serão gravados (em produção aponte para um volume persistente)
UPLOADS_DIR=/data/uploads
MAX_UPLOAD_MB=10

# ===== Google Sheets =====
SHEETS_ENABLED=true
# ID da planilha (a parte entre /d/ e /edit na URL do Google Sheets)
GOOGLE_SHEETS_ID=
# Nome da aba onde as inscrições serão gravadas
GOOGLE_SHEETS_TAB=Inscrições
# Opção A: caminho para o arquivo JSON da service account
GOOGLE_APPLICATION_CREDENTIALS=/data/google-service-account.json
# Opção B (alternativa ao arquivo): credenciais inline
# GOOGLE_CLIENT_EMAIL=conta@projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== E-mail (Gmail / Google Workspace) =====
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Usuário e SENHA DE APP (não a senha normal) — https://myaccount.google.com/apppasswords
SMTP_USER=seu-endereco@seudominio.com
SMTP_PASS=senha-de-app-de-16-digitos
# Remetente exibido
MAIL_FROM=Prêmio Cidades Excelentes <seu-endereco@seudominio.com>
# Destino das inscrições (organização). Vários e-mails separados por vírgula.
MAIL_TO_ORG=inscricoes@seudominio.com
# Cópia oculta opcional
MAIL_BCC=
